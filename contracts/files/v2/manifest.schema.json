{
 "$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,
 "required":["schema_version","supplier_code","source_sequence","sequence_stream","generated_at","mode","format","scope","files","contract_version"],
 "properties":{
  "schema_version":{"const":"2.0"},"supplier_code":{"type":"string","minLength":1},
  "source_sequence":{"type":"integer","minimum":1},"sequence_stream":{"type":"string","minLength":1},
  "generated_at":{"type":"string","format":"date-time"},"mode":{"enum":["snapshot","delta"]},
  "format":{"enum":["csv","xlsx","json"]},"contract_version":{"type":"string","minLength":1},
  "scope":{"type":"object","additionalProperties":false,
   "required":["property_codes","entities","stay_date_from","stay_date_to_exclusive","authority"],
   "properties":{
    "property_codes":{"type":"array","minItems":1,"maxItems":1,"items":{"type":"string","minLength":1}},
    "entities":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["properties","rooms","rate_plans","inventory","rates"]}},
    "stay_date_from":{"type":"string","format":"date"},"stay_date_to_exclusive":{"type":"string","format":"date"},
    "authority":{"type":"object","additionalProperties":false,"properties":{
     "inventory":{"type":"array","uniqueItems":true,"items":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"string"}}},
     "rates":{"type":"array","uniqueItems":true,"items":{"type":"array","minItems":5,"maxItems":5,"items":{"type":"string"}}}
    }}
   }},
  "files":{"type":"array","minItems":1,"maxItems":5,"items":{"type":"object","additionalProperties":false,"required":["name","sha256"],"properties":{
   "name":{"enum":["properties.csv","rooms.csv","rate_plans.csv","inventory.csv","rates.csv","data.xlsx","data.json"]},
   "sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}
  }}}
 }
}

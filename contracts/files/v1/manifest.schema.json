{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "supplier_code",
    "source_sequence",
    "generated_at",
    "mode",
    "scope",
    "files",
    "contract_version"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "supplier_code": {
      "type": "string",
      "minLength": 1
    },
    "source_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "enum": [
        "snapshot",
        "delta"
      ]
    },
    "contract_version": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "property_codes",
        "entities",
        "stay_date_from",
        "stay_date_to_exclusive"
      ],
      "properties": {
        "property_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "entities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "properties",
              "rooms",
              "rate_plans",
              "inventory",
              "rates"
            ]
          }
        },
        "stay_date_from": {
          "type": "string",
          "format": "date"
        },
        "stay_date_to_exclusive": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sha256"
        ],
        "properties": {
          "name": {
            "enum": [
              "properties.csv",
              "rooms.csv",
              "rate_plans.csv",
              "inventory.csv",
              "rates.csv"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}

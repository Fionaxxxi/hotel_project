APP_ENV=development
DEV_AUTH_ENABLED=false
DEV_LOGIN_PASSWORD=<local-only-secret>
JWT_SECRET=<at-least-32-random-characters>
HOTEL_POSTGRES_PASSWORD=<bootstrap-secret>
MIGRATION_PASSWORD=<migration-secret>
APP_DB_PASSWORD=<application-secret>
BOOTSTRAP_DATABASE_URL=postgresql://postgres:<bootstrap-secret>@127.0.0.1:55432/postgres
MIGRATION_DATABASE_URL=postgresql://hotel_migrator:<migration-secret>@127.0.0.1:55432/hotel_project
DATABASE_URL=postgresql://hotel_app:<application-secret>@127.0.0.1:55432/hotel_project
DEMO_CLOCK_ENABLED=false
SIM_FAULTS_ENABLED=false
SIM_A_TOKEN=<local-simulator-account-a-secret>
SIM_B_TOKEN=<local-simulator-account-b-secret>
SIM_MIGRATION_PASSWORD=<simulator-migration-secret>
SIM_APP_PASSWORD=<simulator-application-secret>
SIM_MIGRATION_URL=postgresql://hotel_sim_migrator:<simulator-migration-secret>@127.0.0.1:55432/hotel_project_sim
SIM_DATABASE_URL=postgresql://hotel_sim_app:<simulator-application-secret>@127.0.0.1:55432/hotel_project_sim

# G4 standalone application default; g4.ps1 start explicitly opts into prepared local inference
G4_AI_ENABLED=false
